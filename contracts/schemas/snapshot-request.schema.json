{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctv-stream.invalid/schemas/snapshot-request.schema.json",
  "title": "Snapshot request",
  "description": "Reconciliation payload sent to POST /v1/snapshot when the local outbox is incomplete. It marks current state only; it never deletes history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "sent_at", "tables"],
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]00:00)$"
    },
    "tables": {
      "description": "At most 500 tables or 64 KB per request. The byte limit is enforced by the server.",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "https://cctv-stream.invalid/schemas/table-status.schema.json" }
    }
  }
}