<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- RTSP preview over the local Wi-Fi. No camera permission: the app never
         records; it only reads an existing CCTV stream. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WS-Discovery replies arrive as UDP multicast; Android drops them
         without an explicit multicast lock, held only while a scan runs. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 13+ runtime permission for the permanent monitoring notification.
         Monitoring still runs if the user declines; the notification is simply
         hidden, so this is never a gate. Requested on the first start, not at login. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The monitoring notification is a real media-playback foreground service:
         it keeps the single RTSP preview alive while the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer `WAKE_MODE_NETWORK`: keep decoding while the screen is off.
         Normal permission, granted at install; no runtime prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional biometric unlock on the login screen (normal permission).
         The PIN keypad stays available on devices without a sensor. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".MonitorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monitor">
        <!-- WorkManager must start through MonitorApp.Configuration.Provider so
             Hilt can build SyncWorker. The default initializer would run before
             injection and crash on the first enqueue. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monitor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the notification (and the RTSP session) alive when the screen
             turns off. `stopWithTask`: swiping the app away ends the session, so
             the notification can never outlive the stream it describes.
             Not exported: only this app starts or stops it. -->
        <service
            android:name=".service.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!-- "Hentikan" action on the monitoring notification. Explicit
             component, not exported, so no other app can stop monitoring. -->
        <receiver
            android:name=".service.StopMonitoringReceiver"
            android:exported="false" />

        <!-- onnxruntime-android 1.32.0 ships a telemetry ContentProvider that
             initialises an HTTP client. This app is offline-first, so the
             provider is dropped at manifest merge. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />
    </application>
</manifest>
